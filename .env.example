# ---------------------------------------------------------------------------
# HashmiMart Admin — environment
#
# Copy to .env.local and fill in. .env.local is git-ignored and must never be
# committed. No value below may be moved to a NEXT_PUBLIC_* variable except the
# Firebase web config block at the bottom, which is client-safe by design.
# ---------------------------------------------------------------------------

# --- Server-only: Firebase Admin SDK -----------------------------------------
# Two ways to supply this; the file wins if both are present.
#
# LOCAL DEVELOPMENT — easiest:
#   Save the JSON Firebase gives you (Project Settings -> Service Accounts ->
#   Generate new private key) as `service-account.json` in the project root.
#   It is git-ignored. Nothing below is needed. To keep it elsewhere:
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/key.json
#
# DEPLOYMENT — hosting providers take variables, not files, so use these.
# The private key must be one line, in double quotes, keeping its \n markers.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_STORAGE_BUCKET=

# --- Server-only: image provider keys ----------------------------------------
# Requests to these providers are made only from Next.js route handlers.
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Only needed if an Unsplash OAuth flow is actually used.
UNSPLASH_SECRET_KEY=

# --- Server-only: session signing --------------------------------------------
# Required in production. Generate with: openssl rand -base64 48
AUTH_SESSION_SECRET=

# --- Development only ---------------------------------------------------------
# Password for local sign-in while Firebase is unconfigured. Never set this in a
# deployed environment; configure Firebase Auth instead.
DEV_ADMIN_PASSWORD=

# Skips sign-in entirely and treats every request as a super admin, so the
# dashboard can be opened while authentication is still being set up. A
# production build refuses it regardless of this value, and the topbar shows a
# red "Login off" badge while it is active. Delete the line to restore login.
# DEV_AUTH_BYPASS=true

# --- Media studio runtime (all optional) --------------------------------------
# Where the browser fetches the background-removal weights. The default serves
# them from this app, which fetches and hash-verifies them on first use, so
# normally there is nothing to set. Point this at a CDN to serve them elsewhere.
# NEXT_PUBLIC_REMBG_MODEL_BASE_URL=
#
# Where the browser fetches the ONNX Runtime .wasm files. The default is
# /ort/, populated from node_modules on install.
# NEXT_PUBLIC_ORT_BASE_URL=
#
# Server-side: where a self-fetched model is cached. Defaults to the system temp
# directory. Set this on a host whose temp directory is wiped between requests.
# HM_MODEL_CACHE_DIR=

# --- Client-safe Firebase web config -----------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
